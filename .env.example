# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# WHATSAPP_VERIFY_TOKEN: Token de verificação do Webhook do WhatsApp na Meta Cloud API
WHATSAPP_VERIFY_TOKEN="meu_token_secreto_seguro_2026"

# WHATSAPP_API_URL: URL do endpoint da Graph API da Meta para envio de mensagens
WHATSAPP_API_URL="https://graph.facebook.com/v21.0/SEU_PHONE_NUMBER_ID/messages"

# WHATSAPP_ACCESS_TOKEN: Token de acesso permanente da Meta Graph API
WHATSAPP_ACCESS_TOKEN="seu_token_permanente_da_meta"
