    }

    const btnRunAllStressTests = document.getElementById('btnRunAllStressTests');
    if (btnRunAllStressTests) {
      btnRunAllStressTests.addEventListener('click', () => {
        const badges = document.querySelectorAll('.test-badge');
        badges.forEach(b => {
          b.className = 'test-badge px-2 py-0.5 rounded-full bg-indigo-500/20 text-indigo-300 border border-indigo-500/30 font-bold animate-pulse';
          b.textContent = 'Executando...';
