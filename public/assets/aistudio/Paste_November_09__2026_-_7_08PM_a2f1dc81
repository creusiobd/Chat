      <!-- TOP BAR GLOBAL -->
      <header class="h-16 border-b border-slate-800 bg-slate-950/60 backdrop-blur-md px-6 flex items-center justify-between z-10 shrink-0">
        <div>
          <h2 id="currentTabTitle" class="text-base font-bold text-white flex items-center gap-2">
            Simulador de Atendimento Omnicanal
          </h2>
          <p id="currentTabSubtitle" class="text-xs text-slate-400">Ambiente de homologação em tempo real com Function Calling ativo</p>
