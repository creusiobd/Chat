    const btnResetContext = document.getElementById('btnResetContext');

    function appendMessage(sender, text, isToolCall = false, toolName = '') {
      const isUser = sender === 'user';
      const msgWrapper = document.createElement('div');
      msgWrapper.className = `flex gap-3 ${isUser ? 'justify-end' : 'justify-start'} animate-slide-up`;

      const timeStr = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

      if (isUser) {
        msgWrapper.innerHTML = `
          <div class="space-y-1 max-w-[85%] text-right">
            <div class="bg-indigo-600 text-white rounded-2xl rounded-tr-sm px-4 py-3 text-xs sm:text-sm leading-relaxed shadow-md shadow-indigo-600/20">
              ${text}
            </div>
            <span class="text-[10px] text-slate-500 block px-1">${timeStr} • Você</span>
          </div>
          <div class="w-8 h-8 rounded-xl bg-slate-800 text-slate-200 flex items-center justify-center font-bold text-xs shrink-0">
            VC
          </div>
        `;
      } else {
        let toolBadgeHtml = '';
        if (isToolCall) {
          toolBadgeHtml = `
            <div class="mb-2 inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 font-mono text-[10px]">
              <span class="w-1.5 h-1.5 rounded-full bg-indigo-400 animate-ping"></span>
              Ferramenta Executada: ${toolName}
            </div>
          `;
        }

        msgWrapper.innerHTML = `
          <div class="w-8 h-8 rounded-xl bg-indigo-600 text-white flex items-center justify-center font-bold text-xs shrink-0 shadow-md shadow-indigo-600/30">
            OF
          </div>
          <div class="space-y-1 max-w-[85%]">
            ${toolBadgeHtml}
            <div class="bg-slate-900 border border-slate-800 text-slate-200 rounded-2xl rounded-tl-sm px-4 py-3 text-xs sm:text-sm leading-relaxed shadow-sm">
              ${text}
            </div>
            <span class="text-[10px] text-slate-500 block px-1">${timeStr} • Gemini 2.5 Flash</span>
          </div>
        `;
      }

      chatFeed.appendChild(msgWrapper);
      chatFeed.scrollTop = chatFeed.scrollHeight;
    }

    formChatSimulator.addEventListener('submit', (e) => {
      e.preventDefault();
      const text = inputChatMessage.value.trim();
      if (!text) return;

      appendMessage('user', text);
      inputChatMessage.value = '';

      // Simulação inteligente de resposta com base no texto
      setTimeout(() => {
        const lower = text.toLowerCase();
        if (lower.includes('1001')) {
          appendMessage('bot', 'Localizei seu pedido <strong>PED-1001</strong>! O status atual é <strong>Em trânsito</strong> com a transportadora. Código de rastreamento: <code>BR987654321</code>. A previsão de entrega é 14/11/2026.', true, 'consultar_pedido(codigo_pedido="PED-1001")');
        } else if (lower.includes('rastrear') && !lower.includes('ped-')) {
          appendMessage('bot', 'Com certeza! Para consultar o rastreamento em tempo real, por favor informe o <strong>número do seu pedido</strong> (por exemplo: <code>PED-1001</code>).');
        } else if (lower.includes('devolução') || lower.includes('troca')) {
          appendMessage('bot', 'De acordo com a nossa política oficial, você tem até <strong>7 dias corridos</strong> após o recebimento para solicitar o cancelamento por arrependimento (Art. 49 do CDC). Para defeitos de fabricação, o prazo de garantia é de <strong>90 dias</strong>.');
        } else if (lower.includes('atendente') || lower.includes('procon') || lower.includes('humano')) {
          appendMessage('bot', 'Compreendo perfeitamente a sua solicitação. Acabei de abrir um chamado prioritário (<strong>#CH-8493</strong>) e transferi este atendimento com todo o resumo da nossa conversa para a nossa equipe humana.', true, 'abrir_chamado_humano(motivo="Solicitação de atendente")');
          const badgeCount = document.getElementById('badgeHandoffCount');
          if (badgeCount) badgeCount.textContent = '3';
        } else if (lower.includes('desconto') || lower.includes('90%') || lower.includes('ignore')) {
          appendMessage('bot', 'Minhas diretrizes operacionais seguem estritamente as políticas oficiais da <strong>OmniFlow Enterprise</strong> e não podem ser alteradas no chat. Posso ajudá-lo com consultas de pedidos ou dúvidas sobre nossos produtos.');
        } else {
          appendMessage('bot', `Compreendi sua mensagem sobre "${text}". Estou operando conectado à nossa base de conhecimento e sistemas de pedidos. Como posso auxiliá-lo?`);
        }
      }, 550);
    });

    quickChips.forEach(chip => {
      chip.addEventListener('click', () => {
        inputChatMessage.value = chip.textContent.trim();
        formChatSimulator.dispatchEvent(new Event('submit'));
      });
    });

    btnResetContext.addEventListener('click', () => {
      chatFeed.innerHTML = '';
      appendMessage('bot', 'Sessão reiniciada com sucesso. O histórico de contexto anterior foi limpo do buffer.');
      showToast('Sessão Reiniciada', 'Buffer de memória do Gemini limpo com sucesso.');
