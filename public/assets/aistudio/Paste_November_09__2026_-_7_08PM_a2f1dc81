          newLog2.className = 'text-emerald-400';
          newLog2.textContent = `[${time}] Gemini processed -> 200 OK Response dispatched back to WhatsApp`;
          logs.appendChild(newLog2);
          logs.scrollTop = logs.scrollHeight;
        }, 300);

        showToast('Webhook Disparado', `Mensagem simulada enviada a partir de ${sender}`);
