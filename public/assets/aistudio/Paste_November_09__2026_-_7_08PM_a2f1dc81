              </button>
            </form>

          </div>
        </div>

        <!-- ==================== ABA 2: BASE DE CONHECIMENTO (RAG) ==================== -->
        <div id="tab-knowledge" class="tab-pane hidden max-w-5xl mx-auto space-y-6 animate-fade-in">
          
          <div class="flex flex-wrap items-center justify-between gap-4">
            <div>
              <h3 class="text-lg font-bold text-white">Documentos e Políticas Oficiais</h3>
              <p class="text-xs text-slate-400">Estes textos são injetados diretamente na instrução de sistema do Gemini como Fonte da Verdade.</p>
            </div>
            <button id="btnNovoDoc" class="bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-semibold px-4 py-2.5 rounded-xl transition flex items-center gap-2 shadow-lg shadow-indigo-600/20">
