          showToast('Bateria Concluída', 'Todos os 6 testes de estresse (TC-01 a TC-06) foram aprovados.');
        }, 1200);
      });
    }

    const takeTicketBtns = document.querySelectorAll('.btnTakeTicket');
    takeTicketBtns.forEach(btn => {
