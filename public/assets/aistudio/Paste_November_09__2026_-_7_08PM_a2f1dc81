        <div id="tab-chat" class="tab-pane active h-full flex flex-col max-w-5xl mx-auto space-y-4 animate-fade-in">
          
          <!-- Seletor de Canal Simulado & Métricas -->
          <div class="bg-slate-950/80 border border-slate-800/80 rounded-2xl p-3 flex flex-wrap items-center justify-between gap-3 shadow-xl">
            <div class="flex items-center gap-2">
              <span class="text-xs text-slate-400 font-medium">Canal Ativo:</span>
              <div class="inline-flex p-1 bg-slate-900 rounded-xl border border-slate-800 text-xs">
                <button id="channelWebBtn" class="px-3 py-1 rounded-lg bg-indigo-600 text-white font-semibold transition">Webchat Widget</button>
                <button id="channelWaBtn" class="px-3 py-1 rounded-lg text-slate-400 hover:text-white transition">WhatsApp Oficial</button>
              </div>
            </div>

            <div class="flex items-center gap-3 text-xs">
              <div class="flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                <span class="text-slate-300">Tool: <code class="text-indigo-400">consultar_pedido</code></span>
              </div>
              <div class="flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-amber-500"></span>
                <span class="text-slate-300">Tool: <code class="text-indigo-400">abrir_chamado_humano</code></span>
              </div>
            </div>
          </div>

          <!-- Janela do Chat -->
          <div class="flex-1 bg-slate-950/90 border border-slate-800/80 rounded-2xl flex flex-col overflow-hidden shadow-2xl min-h-[480px]">
            
            <!-- Feed de Mensagens -->
            <div id="chatFeed" class="flex-1 p-5 overflow-y-auto space-y-4 dark-scroll">
              
              <!-- Mensagem Inicial do Bot -->
              <div class="flex gap-3 justify-start animate-slide-up">
                <div class="w-8 h-8 rounded-xl bg-indigo-600 text-white flex items-center justify-center font-bold text-xs shrink-0 shadow-md shadow-indigo-600/30">
                  OF
                </div>
                <div class="space-y-1 max-w-[85%]">
                  <div class="bg-slate-900 border border-slate-800 text-slate-200 rounded-2xl rounded-tl-sm px-4 py-3 text-xs sm:text-sm leading-relaxed shadow-sm">
                    Olá! Sou o assistente virtual oficial da <strong>OmniFlow</strong>. Posso consultar o rastreamento do seu pedido, tirar dúvidas sobre prazos e políticas, ou direcionar para a nossa equipe. Como posso ajudar?
                  </div>
                  <span class="text-[10px] text-slate-500 block px-1">Hoje às 12:00 • Respondido via Gemini 2.5 Flash</span>
                </div>
              </div>

            </div>

            <!-- Sugestões Rápidas -->
            <div class="px-4 py-2 bg-slate-900/60 border-t border-slate-800/80 flex items-center gap-2 overflow-x-auto text-xs dark-scroll">
              <span class="text-[10px] text-slate-500 font-bold uppercase tracking-wider shrink-0">Testes Rápidos:</span>
              <button class="quick-chip whitespace-nowrap px-3 py-1 rounded-full bg-slate-800 hover:bg-indigo-600 hover:text-white text-slate-300 transition text-xs border border-slate-700/60">
                Onde está o PED-1001?
              </button>
              <button class="quick-chip whitespace-nowrap px-3 py-1 rounded-full bg-slate-800 hover:bg-indigo-600 hover:text-white text-slate-300 transition text-xs border border-slate-700/60">
                Quero rastrear minha compra
              </button>
              <button class="quick-chip whitespace-nowrap px-3 py-1 rounded-full bg-slate-800 hover:bg-indigo-600 hover:text-white text-slate-300 transition text-xs border border-slate-700/60">
                Qual o prazo de devolução?
              </button>
              <button class="quick-chip whitespace-nowrap px-3 py-1 rounded-full bg-slate-800 hover:bg-indigo-600 hover:text-white text-slate-300 transition text-xs border border-slate-700/60">
                Quero falar com um atendente
              </button>
            </div>

            <!-- Formulário de Envio -->
            <form id="formChatSimulator" class="p-3 bg-slate-900 border-t border-slate-800/80 flex items-center gap-2">
              <input
